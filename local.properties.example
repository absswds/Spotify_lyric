# Set the path to your Android SDK here
# sdk.dir=/path/to/Android/Sdk

# Spotify Developer app credentials (register at https://developer.spotify.com/dashboard)
# spotify.client.id=YOUR_SPOTIFY_CLIENT_ID

# Release signing (optional; keep the keystore and passwords out of git and back them up)
# release.store.file=C:/Users/YourUser/keys/lyrics-card-release.jks
# release.store.password=...
# release.key.alias=lyrics-card
# release.key.password=...
